  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "author": "Yoshihiko Takeuchi",
  "homepage": "https://github.com/cy-takeuchi/chrome-extensions/tree/main/packages/hayame#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cy-takeuchi/chrome-extensions.git",
    "directory": "packages/hayame"
  },
  "bugs": {
    "url": "https://github.com/cy-takeuchi/chrome-extensions/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "prepare": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "biome:check": "biome check .",
    "biome:write": "biome check --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "happy-dom": "^20.14.6",
    "playwright": "1.64.0",
    "typescript": "~7.0.2",
    "vitest": "^5.0.3",
    "web-ext": "^10.7.0",
    "wxt": "^0.21.4"
  }
}
