# kintone/cybozu authentication for Playwright testing
# Values are 1Password secret references resolved by `op run` (see CONTRIBUTING.md)
KINTONE_URL=op://<vault>/<item>/url
KINTONE_USERNAME1=op://<vault>/<item1>/username
KINTONE_PASSWORD1=op://<vault>/<item1>/password
KINTONE_USERNAME2=op://<vault>/<item2>/username
KINTONE_PASSWORD2=op://<vault>/<item2>/password
KINTONE_SPACE_TEMPLATE_ID=12
