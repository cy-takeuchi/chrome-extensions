{
  "name": "hoi",
  "description": "kintone などの画面で選択したテキストを、元ページへのリンク付きで GitHub Projects に Draft Issue として登録する",
  "private": true,
  "version": "0.2.1",
  "license": "MIT",
  "author": "Yoshihiko Takeuchi",
  "homepage": "https://github.com/cy-takeuchi/chrome-extensions/tree/main/packages/hoi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cy-takeuchi/chrome-extensions.git",
    "directory": "packages/hoi"
  },
  "bugs": {
    "url": "https://github.com/cy-takeuchi/chrome-extensions/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "prepare": "wxt prepare",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "biome:check": "biome check .",
    "biome:write": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "op run --env-file=e2e/.env -- playwright test -c e2e/playwright.config.ts",
    "test:e2e:headed": "op run --env-file=e2e/.env -- playwright test -c e2e/playwright.config.ts --headed"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@types/node": "^26.6.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@kintone/rest-api-client": "^6.3.0",
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "happy-dom": "^20.14.6",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "web-ext": "^10.7.0",
    "wxt": "^0.21.4"
  }
}
