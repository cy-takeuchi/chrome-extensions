    "directory": "packages/hoi"
  },
  "bugs": {
    "url": "https://github.com/cy-takeuchi/chrome-extensions/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "biome:check": "biome check .",
    "biome:write": "biome check --write .",
    "preview": "vite preview",
    "test:e2e": "op run --env-file=e2e/.env -- playwright test -c e2e/playwright.config.ts",
    "test:e2e:headed": "op run --env-file=e2e/.env -- playwright test -c e2e/playwright.config.ts --headed"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@types/node": "^26.6.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@crxjs/vite-plugin": "^3.0.0",
    "@kintone/rest-api-client": "^6.2.1",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.2"
  }
